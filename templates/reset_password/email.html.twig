{# templates/reset_password/email.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: sans-serif;
            background-color: #f4f4f4;
            color: #333;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
        }

        .header {
            background: linear-gradient(to right, #4CAF50, #8BC34A);
            padding: 20px;
            text-align: center;
        }

        .content {
            padding: 30px;
            line-height: 1.6;
            font-size: 16px;
        }

        .footer {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #777;
        }

        .button {
            display: inline-block;
            background-color: #4CAF50;
            color: #ffffff;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }
    </style>
    <title>Réinitialisation de votre mot de passe</title>
</head>
<body>
<div class="container">
    <div class="header">
        {# On utilise le même 'cid' pour le logo #}
        <img src="{{ 'cid:logo-txt' }}" alt="Afpa Connect Logo" width="200">
    </div>
    <div class="content" style="color: #333333;">
        <h3>Bonjour !</h3>

        <p>
            Pour réinitialiser votre mot de passe, veuillez cliquer sur le bouton ci-dessous :
        </p>

        <br>
        <p style="text-align:center;">

            <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" class="button"
               style="color: #ffffff; text-decoration: none;">
                Réinitialiser mon mot de passe
            </a>
        </p>
        <br>

        <p class="text-sm">
            Ce lien expirera
            dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
        </p>

        <p>
            Si vous n'avez pas demandé de réinitialisation de mot de passe, vous pouvez ignorer cet e-mail en toute
            sécurité.
        </p>
    </div>
    <div class="footer">
        <p>Cet email a été envoyé automatiquement. Merci de ne pas y répondre.</p>
    </div>
</div>
</body>
</html>
