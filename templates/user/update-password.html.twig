{% extends 'base.html.twig' %}

{% block title %}Modifier le mot de passe de : {{ user.nickname }}{% endblock %}

{% block body %}
    <twig:ContainerMobile>
        <twig:CardHome>
            <twig:PageTitle>Modifier le mot de passe de :</twig:PageTitle>
            <div class="text-2xl font-bold mb-6 text-center">{{ user.nickname }}</div>

            <div class="mt-2 mb-2 ml-2">
                <a href="{{ app.request.headers.get('referer') ?? path('app_user_index') }}"
                   class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg shadow hover:bg-gray-100 text-gray-700 font-medium transition">
                    ← Retour
                </a>
            </div>

            <p class="text-sm text-gray-500 mb-4 ml-2">
                Les champs marqués d'un <span class="text-red-500">*</span> sont obligatoires.
            </p>
            {{ form_start(form) }}

            <div>
                {{ form_label(form.oldPassword) }}
                {{ form_widget(form.oldPassword) }}
                {% if form.oldPassword.vars.errors|length > 0 %}
                    <div class="mt-1 text-sm text-red-600 ml-2">
                        {% for error in form.oldPassword.vars.errors %}
                            <span>{{ error.message }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <div class="mt-4">
                {{ form_label(form.plainpassword.first) }}

                {% if form.plainpassword.first.vars.errors|length > 0 %}
                    <div class="text-sm text-red-600 ml-2">
                        {% for error in form.plainpassword.first.vars.errors %}
                            <span>{{ error.message }}</span>
                        {% endfor %}
                    </div>
                {% endif %}

                {{ form_widget(form.plainpassword.first) }}
            </div>

            <div class="mt-4">
                {{ form_label(form.plainpassword.second) }}
                {{ form_widget(form.plainpassword.second) }}
            </div>

            {% if form.plainpassword.second.vars.errors|length > 0 %}
                <div class="text-sm text-red-600 ml-2">
                    {% for error in form.plainpassword.second.vars.errors %}
                        <span>{{ error.message }}</span>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="flex justify-center items-center space-x-4 mt-6">
                <twig:Button color="primary">
                    {{ button_label|default('Modifier') }}
                </twig:Button>
            </div>

            {{ form_end(form) }}

        </twig:CardHome>
    </twig:ContainerMobile>
{% endblock %}
