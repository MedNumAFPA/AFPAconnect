{% for type,messages in app.flashes(['success','danger','info'])%}
	{% for message in messages %}
		<div class="absolute top-27">
			<div class="toast flex items-center bg-white text-black px-4 py-4 rounded-xl shadow-lg space-x-3 max-w-md text-center border border-gray-200">
				<i class="fas {{ type == 'success' ? 'fa-circle-check text-primary' : (type == 'info' ? 'fa-circle-exclamation text-info' : 'fa-triangle-exclamation text-danger') }} fa-xl"></i>
				<p>{{message}}</p>
				<button id="closeToast" class="text-gray-900 font-bold">&times;</button>
			</div>
		</div>

		 <script>
										const toasts = document.getElementsByClassName("toast");
						Array.from(toasts).forEach((toast) => {
						    setTimeout(() => {
						        toast.classList.remove("flex");
						        toast.classList.add("hidden");
						    }, 3000);
						    const closeBtn = document.getElementById("closeToast");
						    closeBtn.addEventListener("click", () => {
						        toast.classList.remove("flex");
						        toast.classList.add("hidden");
						    });
						});
															
										</script>
	{% endfor %}
{% endfor %}
