{% extends 'base.html.twig' %}

{% block title %}Créneaux
{% endblock %}

{% block body %}
    <twig:ContainerMobile>

        {% include "layouts/flash_message.html.twig" %}

        <twig:CardHome>
            <twig:PageTitle class="mb-6">Créneaux</twig:PageTitle>
            <twig:Link color="primary" href="{{ path('app_time_slot_new_batch') }}">Ajouter</twig:Link>

            <div class="my-8 flex justify-center md:mt-4 md:mb-12 md:justify-start">
                <a href="{{ path('app_dashboard_admin') }}"
                   class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg shadow hover:bg-gray-100 text-gray-700 font-medium transition">
                    ← Retour
                </a>
            </div>

            {% if workshops is not empty %}
                <div class="space-y-4">

                    {% for workshop in workshops %}
                        <div class="">

                            <div class="accordion-header border rounded-xl w-full p-3 bg-white hover:bg-gray-100
                                cursor-pointer flex justify-between items-center h-[50-px]">
                                <h3 class="w-full text-center text-lg font-semibold">{{ workshop.name }}</h3>
                                <span class="accordion-arrow transform transition-transform duration-300">▼</span>
                            </div>

                            <div
                                class="accordion-content hidden max-h-[440px] overflow-y-auto rounded-b-lg">

                                {% if workshop.timeSlots is not empty %}

                                    <twig:TableTimeSlots class="hidden md:flex">
                                        <thead class="uppercase border-b-2 text-xs">
                                        <tr>
                                            <th scope="col" class="px-2 py-3">ID</th>
                                            <th scope="col" class="px-2 py-3">Date</th>
                                            <th scope="col" class="px-2 py-3">Début</th>
                                            <th scope="col" class="px-2 py-3">Fin</th>
                                            <th scope="col" class="px-2 py-3">Animateur(s)</th>
                                            <th scope="col" class="px-2 py-3 text-center">Actions</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for time_slot in workshop.timeSlots %}
                                            <tr class="border-b dark:border-neutral-600">
                                                <td class="px-2 py-4">{{ time_slot.id }}</td>
                                                <td class="px-2 py-4">{{ time_slot.date ? time_slot.date|date('d/m/Y') : '' }}</td>
                                                <td class="px-2 py-4">{{ time_slot.fromTime ? time_slot.fromTime|date('H:i') : '' }}</td>
                                                <td class="px-2 py-4">{{ time_slot.toTime ? time_slot.toTime|date('H:i') : '' }}</td>
                                                <td class="px-2 py-4">
                                                    {% if time_slot.users is not empty %}
                                                        {% for user in time_slot.users %}
                                                            <div class="text-sm">{{ user.nickname }}</div>
                                                        {% endfor %}
                                                    {% else %}
                                                        <span class="text-xs text-gray-400">Aucun</span>
                                                    {% endif %}
                                                </td>
                                                <td class="px-6 py-4">
                                                    <div
                                                        class="flex flex-row justify-center items-center space-x-3 actions">
                                                        <twig:TableLink
                                                            href="{{ path('app_time_slot_edit', {'id': time_slot.id}) }}"
                                                            color="info">
                                                            <i class="fa-solid fa-pen-to-square fa-lg m-1"></i>
                                                        </twig:TableLink>
                                                        {{ include('time_slot/_delete_form.html.twig', { 'time_slot': time_slot }) }}
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </twig:TableTimeSlots>

                                    <div class="flex flex-col items-center md:hidden text-sm text-center w-full">
                                        {% for time_slot in workshop.timeSlots %}
                                            <twig:RecordCard title="{{ time_slot.date|date('d/m/Y') }}"
                                                             class="w-full mb-4">
                                                <table class="text-left my-5 mx-auto">
                                                    <tr>
                                                        <th scope="row" class="py-1 pr-2">Début :</th>
                                                        <td>{{ time_slot.fromTime ? time_slot.fromTime|date('H:i') : '' }}</td>
                                                    </tr>
                                                    <tr>
                                                        <th scope="row" class="py-1 pr-2">Fin :</th>
                                                        <td>{{ time_slot.toTime ? time_slot.toTime|date('H:i') : '' }}</td>
                                                    </tr>
                                                    <tr>
                                                        <th scope="row" class="py-1 pr-2">Animateur(s) :</th>
                                                        <td>
                                                            {% if time_slot.users is not empty %}
                                                                {# Join the nicknames with a comma for a compact display #}
                                                                {{ time_slot.users|map(u => u.nickname)|join(', ') }}
                                                            {% else %}
                                                                <span class="text-xs text-gray-400">N/A</span>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                </table>
                                                <div
                                                    class="flex flex-row justify-center items-center space-x-3 actions">
                                                    <twig:TableLink
                                                        href="{{ path('app_time_slot_edit', {'id': time_slot.id}) }}"
                                                        color="info">
                                                        <i class="fa-solid fa-pen-to-square fa-lg m-1"></i>
                                                    </twig:TableLink>
                                                    {{ include('time_slot/_delete_form.html.twig', { 'time_slot': time_slot }) }}
                                                </div>
                                            </twig:RecordCard>
                                        {% endfor %}
                                    </div>

                                {% else %}
                                    <p class="text-gray-500 px-2 mt-2">Aucun créneau n'est défini for cet atelier.</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

            {% else %}
                <p class="text-center text-gray-500 py-8 ">Aucun atelier n'a été créé pour le moment.</p>
            {% endif %}

        </twig:CardHome>
    </twig:ContainerMobile>
{% endblock %}
