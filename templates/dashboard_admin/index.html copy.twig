{% extends 'base.html.twig' %}
{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="flex flex-col p-5 w-full h-[100vh] bg-gray-50 mt-5">
  <twig:PageTitle class="text-center">Dashboard Admin</twig:PageTitle>

  <ul class="flex space-x-2 border-b mb-4 justify-center">
    {% for i in 1..4 %}
      <li>
        <button onclick="showTab('tab{{ i }}')" 
                id="btn{{ i }}"
                class="px-4 py-2 rounded-t-md font-medium 
                       {% if i == 1 %}
                         bg-primary text-white 
                       {% else %}
                         bg-gray-100 text-gray-600 hover:text-blue-600
                       {% endif %}">
          Semaine {{ 37 + i }}
        </button>
      </li>
    {% endfor %}
  </ul>

  {% for i in 1..4 %}
    <div id="tab{{ i }}" class="overflow-auto bg-white border border-gray-300 rounded-b p-4 {% if i != 1 %}hidden{% endif %}">
      <table class="min-w-full border-collapse">
        <thead>
          <tr class="bg-gray-100 font-semibold text-center">
            <th class="p-2 border border-gray-300">Jour</th>
            {% for day in days %}
              <th class="p-2 border border-gray-300">
                {{ day|capitalize }}<br>
                {{ weekDates['semaine' ~ i][day]|date('d/m/Y') }}
              </th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="font-semibold p-2 border border-gray-300 text-center">Ateliers</td>
            {% set semaineKey = 'semaine' ~ i %}
            {% for day in days %}
              <td class="p-2 border border-gray-300 align-top space-y-3">
                {% set timeslotday = week[semaineKey][day] ?? [] %}
                {% if timeslotday is not empty %}
                  {% for timeslot in timeslotday %}
                    <div class="rounded-lg p-3 shadow-md bg-gradient-to-r 
                      {% if timeslot.workshop.name == 'Atelier 1' %} from-blue-500 to-blue-700 
                      {% elseif timeslot.workshop.name == 'Atelier 2' %} from-yellow-400 to-yellow-600 
                      {% elseif timeslot.workshop.name == 'Atelier 3' %} from-teal-400 to-teal-600 
                      {% elseif timeslot.workshop.name == 'Atelier 4' %} from-purple-500 to-purple-700 
                      {% elseif timeslot.workshop.name == 'Atelier 5' %} from-green-400 to-green-600 
                      {% else %} from-gray-400 to-gray-600 {% endif %} 
                      text-white shadow-lg font-semibold">
                      {{ timeslot.workshop.name }}<br>
                      <small class="text-sm font-normal block">Salle: {{ timeslot.workshop.roomNumber }}</small>
                      <small class="text-sm font-normal block">Places max: {{ timeslot.reservations|length }}/{{ timeslot.workshop.maxSlots }}</small>
                      <small class="text-sm font-normal block">Horaire: {{ timeslot.fromTime|date('H:i') }} - {{ timeslot.toTime|date('H:i') }}</small>
                    </div>
                  {% endfor %}
                {% else %}
                  <div class="text-gray-400 italic text-sm">Aucun atelier</div>
                {% endif %}
              </td>
            {% endfor %}
          </tr>
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>

<script>
  function showTab(tabId) {
    for(let i=1; i <= 4; i++) {
      document.getElementById('tab' + i).classList.add('hidden');
      document.getElementById('btn' + i).classList.remove('bg-primary', 'text-white');
      document.getElementById('btn' + i).classList.add('bg-gray-100', 'text-gray-600');
    }
    document.getElementById(tabId).classList.remove('hidden');
    const index = tabId.replace('tab', '');
    const btn = document.getElementById('btn' + index);
    btn.classList.add('bg-primary', 'text-white');
    btn.classList.remove('bg-gray-100', 'text-gray-600');
  }

  document.addEventListener('DOMContentLoaded', () => {
    showTab('tab1');
  });
</script>
{% endblock %}