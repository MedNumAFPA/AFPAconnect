{% extends 'base.html.twig' %}

{% block title %}Modifier créneau{% endblock %}

{% block body %}
	<twig:ContainerMobile>
		<twig:Card>
			<twig:PageTitle>Modifier créneau</twig:PageTitle>
            <div class="mt-8 mb-8 flex justify-center md:mt-4 md:mb-12 md:justify-start">
                <a href="{{ path('app_time_slot_index') }}" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg shadow hover:bg-gray-100 text-gray-700 font-medium transition">
                    ← Retour
                </a>
            </div>

			<p class="text-sm text-gray-500 mb-4">
				Les champs marqués d'un
				<span class="text-red-500">*</span>
				sont obligatoires.
			</p>
			{{ include('time_slot/_form.html.twig', {'button_label': 'Modifier'}) }}
			<a href="{{ path('app_time_slot_index') }}" class="mt-5">← Retour</a>
		</twig:Card>
	</twig:ContainerMobile>
{% endblock %}
