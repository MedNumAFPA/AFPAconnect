{% extends 'base.html.twig' %}

{% block title %}Index des créneaux{% endblock %}

{% block body %}
    <twig:Container>
        {% include "layouts/flash_message.html.twig" %}

        <twig:Card>
            <twig:PageTitle class="mb-9">Créneaux</twig:PageTitle>

            <twig:Table>
                <thead class="uppercase border-b-2 border-neutral-600">
                <tr>
                    <th scope="col" class="px-2 py-4">Id</th>
                    <th scope="col" class="px-2 py-4">De</th>
                    <th scope="col" class="px-2 py-4">A</th>
                    <th scope="col" class="px-2 py-4">Date</th>
                    <th scope="col" class="px-2 py-4">Atelier</th>
                    <th scope="col" class="px-6 py-4 text-center">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for time_slot in time_slots %}
                    <tr class="border-b dark:border-neutral-600">
                        <td class="px-2 py-4">{{ time_slot.id }}</td>
                        <td class="px-2 py-4">{{ time_slot.fromTime ? time_slot.fromTime|date('H:i') : '' }}</td>
                        <td class="px-2 py-4">{{ time_slot.toTime ? time_slot.toTime|date('H:i') : '' }}</td>
                        <td class="px-2 py-4">{{ time_slot.date ? time_slot.date|date('Y-m-d') : '' }}</td>
                        <td class="px-2 py-4">{{ time_slot.workshop.name }}</td>
                        <td class="px-6 py-4">
                            <div class="flex flex-row justify-center space-x-3">
                                <twig:Link href="{{ path('app_time_slots_edit', {'id': time_slot.id}) }}" color="info">Modifier</twig:Link>
                                {{ include('time_slots/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-4 text-center text-gray-500">Aucun créneau pour le moment.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </twig:Table>

            <twig:Link href="{{ path('app_time_slots_new') }}" color="primary">Ajouter</twig:Link>

        </twig:Card>
    </twig:Container>
{% endblock %}
