{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-6 py-12">
  <h1 class="text-3xl font-semibold mb-8 text-center">Rejoignez-l'AFPA</h1>

  <div class="flex flex-col lg:flex-row gap-8">
    
    <div class="bg-white p-6 rounded-lg shadow-md lg:w-1/3 text-gray-700">
      <h2 class="text-lg font-semibold text-primary mb-4 flex items-center gap-2">
        En transport
      </h2>
      <p class="leading-relaxed text-sm">
        Accès : Bus de Bordeaux ligne 15 arrêt «Cité Thorez» ou «Allende» De gare Saint Jean ligne 16 "Mérignac centre" arrêt "Capucin" ou ligne 9 "Place Maran" arrêt "Rue de Bègles" puis ligne 15 arrêt « Cité Thorez » ou « Allende » Tram C de la gare Saint Jean, direction Bègles "Lycée Vaclav Havel" arrêt "Parc de Mussonville. Parking gratuit sur site.
      </p>
    </div>

    <div class="relative  overflow-hidden rounded">
        <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d2830.983074033729!2d-0.557753321092399!3d44.801533583660735!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sfr!2sfr!4v1756764954450!5m2!1sfr!2sfr" 
         width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>

  </div>
</div>
{% endblock %}
