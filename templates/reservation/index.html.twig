{% extends 'base.html.twig' %}

{% block title %}Réservations{% endblock %}

{% block body %}
    <twig:ContainerMobile>
        {% include "layouts/flash_message.html.twig" %}

        <twig:CardHome data-controller="accordion">
            <twig:PageTitle>Réservations</twig:PageTitle>

            <twig:Link color="primary" href="{{ path('app_reservation_new') }}">Ajouter</twig:Link>

            <div class="mt-8 mb-4 flex justify-center md:mt-4 md:mb-0 md:justify-start">
                <a href="{{ path('app_dashboard_admin') }}"
                   class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg shadow hover:bg-gray-100 text-gray-700 font-medium transition">
                    ← Retour
                </a>
            </div>

            <twig:Table class="hidden md:table">
                <thead class="uppercase border-b-2 border-neutral-600">
                <tr>
                    <th scope="col" class="px-2 py-4">ID</th>
                    <th scope="col" class="px-2 py-4">Prénom</th>
                    <th scope="col" class="px-2 py-4">Nom</th>
                    <th scope="col" class="px-2 py-4">ID Afpa</th>
                    <th scope="col" class="px-2 py-4">Email</th>
                    <th scope="col" class="px-2 py-4">Atelier</th>
                    <th scope="col" class="px-2 py-4">Créneaux</th>
                    <th scope="col" class="px-2 py-4 text-center">Détails</th>
                </tr>
                </thead>

                {% for subscription in subscriptions %}

                    <tbody class="border-b dark:border-neutral-600">
                    {% set main_reservation = subscription.main_reservation %}
                    <tr class="accordion-header cursor-pointer hover:bg-gray-50">
                        <td class="px-2 py-4">{{ main_reservation.id }}</td>
                        <td class="px-2 py-4">{{ main_reservation.firstname }}</td>
                        <td class="px-2 py-4">{{ main_reservation.lastname }}</td>
                        <td class="px-2 py-4">{{ main_reservation.idAfpa }}</td>
                        <td class="px-2 py-4">{{ main_reservation.email }}</td>
                        <td class="px-2 py-4">{{ subscription.workshop.name }}</td>
                        <td class="px-2 py-4">
                                <span class="bg-blue-100 text-blue-800 text-sm font-medium me-2 px-2.5 py-0.5 rounded">
                                    {{ subscription.individual_reservations|length }} créneaux
                                </span>
                        </td>
                        <td class="px-2 py-4 text-center">
                            <span class="accordion-arrow transform transition-transform duration-300">▼</span>
                        </td>
                    </tr>
                    <tr class="accordion-content hidden">
                        <td colspan="8" class="p-0">
                            <div class="p-4 bg-gray-50">
                                <h4 class="font-semibold mb-2">Détail des réservations :</h4>
                                <table class="w-full text-sm text-left">
                                    <thead class="text-xs uppercase bg-gray-200">
                                    <tr>
                                        <th class="px-2 py-2">ID Res.</th>
                                        <th class="px-2 py-2">Date</th>
                                        <th class="px-2 py-2">Horaire</th>
                                        <th class="px-2 py-2">Rappel</th>
                                        <th class="px-2 py-2">Envoyé</th>
                                        <th class="px-2 py-2 text-center">Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for reservation in subscription.individual_reservations %}
                                        <tr class="border-b bg-white">
                                            <td class="px-2 py-2">{{ reservation.id }}</td>
                                            <td class="px-2 py-2">{{ reservation.timeslot.date|date('d/m/Y') }}</td>
                                            <td class="px-2 py-2">{{ reservation.timeslot.fromTime|date('H:i') }}
                                                - {{ reservation.timeslot.toTime|date('H:i') }}</td>
                                            <td class="px-2 py-2">{{ reservation.isReminderActive ? 'Oui' : 'Non' }}</td>
                                            <td class="px-2 py-2">{{ reservation.reminderSentAt ? 'Oui' : 'Non' }}</td>
                                            <td class="px-2 py-4 space-x-2">
                                                <div class="flex flex-row justify-center space-x-3 actions">
                                                    <twig:TableLink color="info" href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">
                                                        <i class="fa-solid fa-pen-to-square fa-lg m-1"></i>
                                                    </twig:TableLink>

                                                    {{ include('reservation/_delete_form.html.twig', { 'reservation': reservation }) }}
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                {% else %}
                    <tbody>
                    <tr>
                        <td colspan="8" class="px-6 py-4 text-center text-gray-500">Aucune réservation pour le moment.
                        </td>
                    </tr>
                    </tbody>
                {% endfor %}
            </twig:Table>

            <div class="flex flex-col items-center gap-y-4 md:hidden text-sm text-center w-full mt-4">
                {% for subscription in subscriptions %}
                    {% set main_reservation = subscription.main_reservation %}
                    <div class="w-full border rounded-lg shadow-sm">
                        <div
                            class="accordion-header bg-white p-4 cursor-pointer flex justify-between items-center rounded-lg">
                            <div>
                                <div
                                    class="font-bold text-base text-left">{{ main_reservation.firstname }} {{ main_reservation.lastname }}</div>
                                <div class="text-gray-600 text-left">{{ subscription.workshop.name }}</div>
                            </div>
                            <span class="accordion-arrow transform transition-transform duration-300">▼</span>
                        </div>
                        <div class="accordion-content hidden p-4 border-t bg-gray-50">
                            {% for reservation in subscription.individual_reservations %}
                                <div class="flex justify-between items-center py-2 {% if not loop.last %}border-b{% endif %}">

                                    <div class="flex flex-col text-left">
                                        <strong>{{ reservation.timeslot.date|date('d/m/Y') }}</strong>
                                        <span class="text-gray-600">{{ reservation.timeslot.fromTime|date('H:i') }} - {{ reservation.timeslot.toTime|date('H:i') }}</span>
                                    </div>
                                        <div class="flex flex-row justify-center space-x-3 actions flex-shrink-0 ml-2">
                                            <twig:TableLink color="info" href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">
                                                <i class="fa-solid fa-pen-to-square fa-lg m-1"></i>
                                            </twig:TableLink>

                                            {{ include('reservation/_delete_form.html.twig', { 'reservation': reservation }) }}
                                        </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    <p class="text-center text-gray-500">Aucune réservation pour le moment.</p>
                {% endfor %}
            </div>

        </twig:CardHome>
    </twig:ContainerMobile>
{% endblock %}
