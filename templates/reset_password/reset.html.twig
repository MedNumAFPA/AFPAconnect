{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    <twig:Container>
        <twig:Card>
            <twig:PageTitle>Réinitialisez votre mot de passe</twig:PageTitle>

            {{ form_start(resetForm) }}
            {# Ce champ "plainPassword" est un RepeatedType, il affichera deux champs de mot de passe #}
            {{ form_row(resetForm.plainPassword) }}

            <div class="mt-6">
                <twig:Button color="primary">Réinitialiser le mot de passe</twig:Button>
            </div>
            {{ form_end(resetForm) }}
        </twig:Card>
    </twig:Container>
{% endblock %}
