{% extends 'base.html.twig' %}

{% block title %}AFPA Connect{% endblock %}

{% block body %}

	<div class="min-h-[100vh]">

		<div class="max-h-[50vh] bg-gradient-to-br from-[#22bb33] via-[#22c55e] to-[#4ade80]">

			<twig:ContainerMobile>

				<twig:CardHome>
					<div id="logo" class="flex flex-col items-center justify-center">
						<h1 class="font-extrabold text-center lg:text-6xl">Bienvenue sur</h1>
						<div class="flex flex-row items-center justify-center">
							<img class=" max-w-[30%] mb-6" src="{{ asset('images/logo-txt.svg') }}" alt="">
							<img class="max-w-[25%] mb-6" src="{{ asset('images/logo.svg') }}" alt="">
						</div>
					</div>

					<div class=" border-t border-primary mt-6 pt-6">
						<div class="flex flex-col items-center justify-center mt-15">
							<h3 class="font-extrabold text-center lg:text-3xl">Les Atelier Disponibles
							</h3>
						</div>
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
							{% for workshop in workshops %}
								<div class="bg-white rounded-lg shadow shadow-primary p-4 flex flex-col items-center">
									<h3 class="font-semibold text-3xl mb-2 text-[#22bb33]">{{ workshop.name }}</h3>
									<p class="text-gray-600 text-xl mb-2">{{ workshop.description }}</p>
								</div>
							{% else %}
								<p class="col-span-3 text-center text-gray-400">Aucun atelier disponible.</p>
							{% endfor %}
						</div>
					</div>

					<div class="flex flex-row items-center justify-center mt-15 mb-6 gap-4">
						<twig:Link href="#" color="primary">je m'inscrit sur une atelier</twig:Link>
						<twig:Link href="#" color="primary">je hésite! je prend un rendez vous</twig:Link>
					</div>
					<p class="text-[var(--foreground)] text-center mb-6">Cliquez ici si vous souhaitez prendre	un rendez-vous avec nos experts</p>


				</twig:CardHome>

			</twig:ContainerMobile>

		</div>
	</div>
	<script>
		document.addEventListener("turbo:load", () => {
			window.screen.width < 450 &&
			document.getElementById("logo").scrollIntoView({ behavior: "smooth" });
		});
	</script>

{% endblock %}
