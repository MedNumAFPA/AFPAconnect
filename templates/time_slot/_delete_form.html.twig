<form class="" method="post" action="{{ path('app_time_slot_delete', {'id': time_slot.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce créneau ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ time_slot.id) }}">
	<twig:TableButton color="danger">
		<i class="fa-solid fa-trash fa-lg m-1"></i>
	</twig:TableButton>
</form>
