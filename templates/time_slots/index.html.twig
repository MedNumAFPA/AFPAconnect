{% extends 'base.html.twig' %}

{% block title %}Gestion des Créneaux par Atelier{% endblock %}

{% block body %}
    <twig:Container>
        {% include "layouts/flash_message.html.twig" %}

        <twig:Card>
            <twig:PageTitle class="mb-6">Gestion des Créneaux</twig:PageTitle>

            {% if workshops is not empty %}
                <div class="space-y-4">

                    {% for workshop in workshops %}
                        <div class="border rounded-lg">

                            <div
                                class="accordion-header p-4 bg-gray-50 hover:bg-gray-100 cursor-pointer flex justify-between items-center">
                                <h3 class="text-lg font-semibold">{{ workshop.name }}</h3>
                                <span class="accordion-arrow transform transition-transform duration-300">▼</span>
                            </div>

                            <div class="accordion-content hidden p-4 border-t">

                                {% if workshop.timeSlots is not empty %}
                                    <twig:Table>
                                        <thead class="uppercase border-b-2 text-xs">
                                        <tr>
                                            <th scope="col" class="px-2 py-3">ID</th>
                                            <th scope="col" class="px-2 py-3">Date</th>
                                            <th scope="col" class="px-2 py-3">De</th>
                                            <th scope="col" class="px-2 py-3">A</th>
                                            <th scope="col" class="px-2 py-3 text-center">Actions</th>
                                        </tr>
                                        </thead>
                                        <tbody>

                                        {% for time_slot in workshop.timeSlots %}
                                            <tr class="border-b dark:border-neutral-600">
                                                <td class="px-2 py-4">{{ time_slot.id }}</td>
                                                <td class="px-2 py-4">{{ time_slot.date ? time_slot.date|date('d/m/Y') : '' }}</td>
                                                <td class="px-2 py-4">{{ time_slot.fromTime ? time_slot.fromTime|date('H:i') : '' }}</td>
                                                <td class="px-2 py-4">{{ time_slot.toTime ? time_slot.toTime|date('H:i') : '' }}</td>
                                                <td class="px-6 py-4">
                                                    <div class="flex flex-row justify-center space-x-3">
                                                        <twig:Link
                                                            href="{{ path('app_time_slots_edit', {'id': time_slot.id}) }}"
                                                            color="info">Modifier
                                                        </twig:Link>
                                                        {{ include('time_slots/_delete_form.html.twig', { 'time_slot': time_slot }) }}
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </twig:Table>
                                {% else %}
                                    <p class="text-gray-500">Aucun créneau n'est défini pour cet atelier.</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-center text-gray-500 py-8 ">Aucun atelier n'a été créé pour le moment.</p>
            {% endif %}

            <div class="flex justify-center mt-8">
                <twig:Link color="primary" href="{{ path('app_time_slots_new_batch') }}"
                           class="px-2 py-1 bg-blue-500 text-white hover:bg-blue-300">
                    Ajouter
                </twig:Link>
            </div>

            <div class="mt-4">
                <a href="{{ path('app_dashboard_admin') }}">
                    Retour
                </a>
            </div>
        </twig:Card>
    </twig:Container>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('turbo:load', function () {

            const accordionHeaders = document.querySelectorAll('.accordion-header');

            accordionHeaders.forEach(header => {
                header.addEventListener('click', () => {

                    const accordionContent = header.nextElementSibling;

                    const accordionArrow = header.querySelector('.accordion-arrow');

                    accordionContent.classList.toggle('hidden');

                    accordionArrow.classList.toggle('rotate-180');
                });
            });
        });
    </script>
{% endblock %}
