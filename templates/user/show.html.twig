{% extends 'base.html.twig' %}

{% block title %}Utilisateur
	{{ user.id }}
{% endblock %}

{% block body %}
	<h1>Utilisateur
		{{ user.id }}</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ user.id }}</td>
			</tr>
			<tr>
				<th>Email</th>
				<td>{{ user.email }}</td>
			</tr>
			<tr>
				<th>Roles</th>
				<td>{{ user.roles ? user.roles|json_encode : '' }}</td>
			</tr>
		</tbody>
	</table>

	<a class="m-5" href="{{ path('app_user_index') }}">← Retour</a>


	<a href="{{ path('app_user_edit', {'id': user.id}) }}">Modifier</a>

{% endblock %}
