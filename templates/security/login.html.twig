{% extends 'base.html.twig' %}

{% block title %}Connexion
{% endblock %}

{% block body %}
    {#    <twig:ContainerMobile> #}
    <div class="flex flex-col items-center justify-center md:min-h-[80vh] min-h-[20vh] min-w-[100vw] mt-0">


        <twig:CardHome>

            <form method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        Vous êtes connecté en tant que
                        {{ app.user.userIdentifier }},
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    </div>
                {% endif %}

                <twig:PageTitle class="h3 mb-3 font-weight-normal">Connectez-vous</twig:PageTitle>

                <div class="mt-2 mb-2 ml-2">
                    <a href="{{ app.request.headers.get('referer') ?? path('app_user_index') }}"
                       class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg shadow hover:bg-gray-100 text-gray-700 font-medium transition">
                        ← Retour
                    </a>
                </div>

                <p class="text-sm text-gray-500 mb-4 ml-2">
                    Les champs marqués d'un <span class="text-red-500">*</span> sont obligatoires.
                </p>

                <label for="username" class="required">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control"
                       autocomplete="email" required autofocus placeholder="Entrez une adresse email valide...">
                <label for="password" class="required">Mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control"
                       autocomplete="current-password" required
                       placeholder="Entrez un mot de passe de 6 caractères minimum...">

                <div class="text-right mt-2 mb-4">
                    <a href="{{ path('app_forgot_password_request') }}" class="text-sm text-blue-600 hover:underline">
                        Mot de passe oublié ?
                    </a>
                </div>

                <input
                    type="hidden" name="_csrf_token" data-controller="csrf-protection"
                    value="{{ csrf_token('authenticate') }}">

                {#
                Décommentez cette section et ajoutez l'option remember_me sous votre pare-feu pour activer la fonctionnalité "Se souvenir de moi".
                Voir https://symfony.com/doc/current/security/remember_me.html

                <div class="checkbox mb-3">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <label for="_remember_me">Se souvenir de moi</label>
                </div>
                #}
                <div class="flex items-center space-x-4 ml-3 mt-3">
                    <twig:Button color="primary" type="submit">
                        Se connecter
                    </twig:Button>
                </div>
            </form>
        </twig:CardHome>
    </div>
    {#    </twig:ContainerMobile> #}

{% endblock %}
