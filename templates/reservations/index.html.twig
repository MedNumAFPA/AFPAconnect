{% extends 'base.html.twig' %}

{% block title %}Index des réservations
{% endblock %}

{% block body %}
	<twig:Container>
		{% include "layouts/flash_message.html.twig" %}

		<twig:Card>
			<twig:PageTitle>Index des réservations</twig:PageTitle>

			<twig:Table>
				<thead class="uppercase border-b-2 border-neutral-600">
					<tr>
						<th scope="col" class="px-2 py-4">Id</th>
						<th scope="col" class="px-2 py-4">Prénom</th>
						<th scope="col" class="px-2 py-4">Nom</th>
						<th scope="col" class="px-2 py-4">Email</th>
						<th scope="col" class="px-2 py-4">Numéro téléphone</th>
						<th scope="col" class="px-2 py-4">Nom de la formation</th>
						<th scope="col" class="px-2 py-4">Rappel activé ?</th>
						<th>Rappel envoyé a :</th>
						<th scope="col" class="px-2 py-4">Créneau</th>
						<th scope="col" class="px-2 py-4 text-center">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for reservation in reservations %}
						<tr class="border-b dark:border-neutral-600">
							<td class="px-2 py-4">{{ reservation.id }}</td>
							<td class="px-2 py-4">{{ reservation.firstname }}</td>
							<td class="px-2 py-4">{{ reservation.lastname }}</td>
							<td class="px-2 py-4">{{ reservation.email }}</td>
							<td class="px-2 py-4">{{ reservation.phoneNumber }}</td>
							<td class="px-2 py-4">{{ reservation.formationName }}</td>
							<td class="px-2 py-4">{{ reservation.isReminderActive ? 'Oui' : 'Non' }}</td>
							<td>{{ reservation.reminderSentAt ? reservation.reminderSentAt|date('d/m/Y à H:i') : 'Non envoyé' }}</td>
							<td class="px-2 py-4">
								{{ reservation.timeslot.fromTime|format_time(locale='fr', pattern='HH:mm') }}
								-
								{{ reservation.timeslot.toTime|format_time(locale='fr', pattern='HH:mm') }}
							</td>

							<td class="px-2 py-4">
								<div class="flex flex-row justify-center space-x-3">
									<twig:Link color="info" href="{{ path('app_reservations_edit', {'id': reservation.id}) }}">
										<i class="fa-solid fa-pen-to-square fa-lg m-1"></i>
									</twig:Link>
									<twig:Link color="danger" href="{{ path('app_reservations_delete', {'id': reservation.id}) }}">
										<i class="fa-solid fa-trash fa-lg m-1"></i>

									</twig:Link>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="9" class="px-6 py-4 text-center text-gray-500">Aucune réservation pour le moment.</td>
						</tr>
					{% endfor %}
				</tbody>
			</twig:Table>

			<div class="md:hidden text-sm">
				{% for reservation in reservations %}
					<twig:RecordCard title="{{reservation.firstname}} {{reservation.lastname}}">

						<table class="text-left my-5">
							<tr>
								<th scope="row" class="">Prénom :</th>
								<td class="">{{ reservation.firstname }}</td>

							</tr>
							<tr>
								<th scope="row" class="">Nom :</th>
								<td class="">{{ reservation.lastname }}</td>

							</tr>
							<tr>
								<th scope="row" class="">Email  :</th>
								<td class=" text-wrap">{{ reservation.email |length > 12 ? reservation.email | slice(0, 12) ~ '...'  : reservation.email }}</td>

							</tr>
							<tr>
								<th scope="row" class="">N.Téléphone  :</th>
								<td class="">{{ reservation.phoneNumber   }}</td>


							</tr>
							<tr>
								<th scope="row" class="">N.Formation :</th>
								<td class="">{{ reservation.formationName |length > 14 ? reservation.formationName | slice(0, 14) ~ ' ...' : reservation.formationName }}</td>
							</tr>
							<tr>
								<th scope="row" class="">Rpl activé ?:</th>
								<td class="">
									{{ reservation.isReminderActive ? 'Oui' : 'Non' }}</td>
							</tr>
							<tr>
								<th scope="row" class="">Rpl envoyé a :</th>
								<td class="">
									{{ reservation.reminderSentAt ? reservation.reminderSentAt|date('d/m/Y à H:i') : 'Non envoyé' }}</td>
							</tr>
							<tr>
								<th scope="row" class="">Créneau :</th>
								<td class="">
									{{ reservation.timeslot.fromTime|format_time(locale='fr', pattern='HH:mm') }}
									-
									{{ reservation.timeslot.toTime|format_time(locale='fr', pattern='HH:mm') }}</td>

							</tr>
						</table>
						<div class="flex flex-row justify-center space-x-3">
							<twig:Link color="info" href="{{ path('app_reservations_edit', {'id': reservation.id}) }}">
								<i class="fa-solid fa-pen-to-square fa-lg m-1"></i>
							</twig:Link>
							<twig:Link color="danger" href="{{ path('app_reservations_delete', {'id': reservation.id}) }}">
								<i class="fa-solid fa-trash fa-lg m-1"></i>
							</twig:Link>
						</div>
					</twig:RecordCard>
				{% endfor %}
			</div>

			<twig:Link color="primary" href="{{ path('app_reservations_new') }}">Ajouter</twig:Link>

		</twig:Card>
	</twig:Container>
{% endblock %}
