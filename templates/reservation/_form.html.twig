{{ form_start(form) }}

{% if form.timeslots is defined %}
    {% if form.timeslots.vars.errors|length > 0 %}
        <div class="mt-2 text-sm text-red-600 space-y-1">
            {% for error in form.timeslots.vars.errors %}
                <div>{{ error.message }}</div>

                {% if error.messageParameters['%duplicates%'] is defined %}
                    <ul class="list-disc list-inside ml-4 mt-1">
                        {% for duplicate_detail in error.messageParameters['%duplicates%'] %}
                            <li>{{ duplicate_detail }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endif %}

<div class="flex flex-col mb-4">
    {{ form_label(form.firstname) }}
    {{ form_widget(form.firstname) }}
    {{ form_errors(form.firstname) }}
</div>

<div class="flex flex-col mb-4">
    {{ form_label(form.lastname) }}
    {{ form_widget(form.lastname) }}
    {{ form_errors(form.lastname) }}
</div>

<div class="flex flex-col mb-4">
    {{ form_label(form.email) }}
    {{ form_widget(form.email) }}
    {{ form_errors(form.email) }}
</div>

<div class="flex flex-col mb-4">
    {{ form_label(form.phoneNumber) }}
    {{ form_widget(form.phoneNumber) }}
    {{ form_errors(form.phoneNumber) }}
</div>

<div class="flex flex-col mb-4">
    {{ form_label(form.idAfpa) }}
    {{ form_widget(form.idAfpa) }}
    {{ form_errors(form.idAfpa) }}
</div>

<div class="flex flex-col mb-4">
    {{ form_label(form.formationName) }}
    {{ form_widget(form.formationName) }}
    {{ form_errors(form.formationName) }}
</div>

{% if form.timeslot is defined %}
    <div class="flex flex-col mb-4">
        {{ form_label(form.timeslot) }}
        {{ form_widget(form.timeslot, {'attr': {'class': 'ml-3 w-full p-2 border border-gray-300 rounded-md bg-white shadow-sm focus:ring-lime-500 focus:border-lime-500'}}) }}
        {{ form_errors(form.timeslot) }}
    </div>
{% endif %}

{% if form.timeslots is defined %}
    {{ form_label(form.timeslots) }}
    <div class="workshop-users-field flex flex-wrap justify-center items-center">

            {% for checkbox in form.timeslots %}
                <div class="flex justify-center items-center space-x-2 flex-none w-[90%] md:max-w-[20%] border rounded-md my-2 md:m-5">
                    {{ form_label(checkbox, null, {'label_attr': {'class': 'test'}}) }}
                    {{ form_widget(checkbox, {'attr': {'class': 'border'}}) }}
                </div>
            {% endfor %}

    </div>

{% endif %}

<div class="flex flex-col justify-center items-center md:items-start mb-4">
    {{ form_label(form.consent) }}
    {{ form_widget(form.consent, {'attr': {'class': 'm-0 pl-5 h-4 w-4 text-lime-600 focus:ring-lime-500 border-gray-300 rounded'}}) }}
    {{ form_errors(form.consent) }}
</div>

<div class="flex justify-center items-center space-x-4 md:ml-0 mt-3">
    <twig:Button color="primary">
        {{ button_label|default("S'inscrire") }}
    </twig:Button>
</div>

{{ form_end(form) }}
