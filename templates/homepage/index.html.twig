{% extends 'base.html.twig' %}

{% block title %}AFPA Connect
{% endblock %}

{% block body %}

    <div class="md:min-h-[80vh] min-h-[70vh]">

        <div class="md:h-[40vh] h-[35vh] bg-gradient-to-br from-[#22bb33] via-[#22c55e] to-[#4ade80]">

            <div class="flex flex-col items-center md:min-h-[80vh] min-h-[70vh] min-w-[100vw]">
                <twig:Card>
                    <div>
                        <div id="logo" class="text-center md:mt-0 mt-8">

                            <h1 class="font-extrabold text-4xl md:text-6xl md:mt-0 -mt-10">Bienvenue sur</h1>
                            <div class="flex md:flex-row flex-col items-center justify-center">
                                <img class="w-1/2 md:w-1/4" src="{{ asset('images/logo-txt.svg') }}"
                                     alt="logo-text AFPA Connect">
                            </div>
                            <div class="flex flex-col items-center ">
                                <p class="text-center text-gray-500 mb-2 px-3 md:px-0 text-sm md:text-base">
                                    Besoin d'aide pour utiliser un ordinateur, créer un mail, chercher un emploi en
                                    ligne ou toutes autres demandes ?
                                </p>
                                <p class="text-center text-gray-500 mb-2 px-3 md:px-0 text-sm md:text-base">
                                    Afpa Connect est l'espace où vous trouverez l'aide dont vous avez besoin pour
                                    utiliser sereinement le numérique dans votre quotidien.
                                    Nous sommes là pour vous accompagner dans la bienveillance, peu importe votre
                                    niveau.
                                    Pour vous inscrire à un atelier ou prendre un rendez-vous,
                                </p>
                                <p class="text-sm text-gray-500 mt-6 mb-2">Faites défiler pour voir les ateliers</p>
                                <div class="flex space-x-12">
                                    <i class="fa-solid fa-chevron-down text-2xl text-gray-400 animate-bounce"></i>
                                    <i class="fa-solid fa-chevron-down text-2xl text-gray-400 animate-bounce"></i>
                                </div>
                            </div>
                        </div>

                        <div class="mt-20">
                            <h3 class="font-extrabold text-center text-3xl mb-8">Les Ateliers Disponibles</h3>

                            <div data-controller="homepage-accordion"
                                 class="flex flex-col md:flex-row items-center justify-center flex-wrap w-max-5xl mx-auto gap-4">
                                {% for workshop in workshops %}

                                    {% if workshop.name != 'Entretien Individuel' %}
                                        <div
                                            class="flex items-center relative bg-gray-100 rounded-lg p-4 transition md:w-[30%] w-full h-20">
                                            <button
                                                class="accordion-header flex items-center justify-between w-full text-left focus:outline-none cursor-pointer">
                                                <h3 class="font-semibold text-xl text-[#22bb33]">{{ workshop.name }}</h3>
                                                <svg
                                                    class="accordion-icon transform transition-transform h-5 w-5 text-gray-400 ml-2"
                                                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                          stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                                </svg>
                                            </button>
                                            <div
                                                class="accordion-content absolute top-full left-0 z-20 w-full bg-white p-4 rounded shadow-lg hidden flex-col items-center mt-2 max-h-96 overflow-y-auto">

                                                <p class="text-gray-700 mb-4 break-words whitespace-pre-wrap ">{{ workshop.description }}</p>

                                                {% set today = "now"|date("Y-m-d") %}

                                                {% set future_timeslots = workshop.timeslots|filter(ts => ts.date|date("Y-m-d") > today) %}
                                                {% set available_timeslots_count = 0 %}

                                                {% if future_timeslots|length > 0 %}
                                                    {% for ts in future_timeslots %}
                                                        {% if ts.reservations|length < workshop.maxSlots %}
                                                            {% set available_timeslots_count = available_timeslots_count + 1 %}
                                                        {% endif %}
                                                    {% endfor %}

                                                    {% set timeslotsParJour = {} %}
                                                    {% for ts in future_timeslots %}
                                                        {% set jourCle = ts.date|format_date(locale='fr', pattern='EEEE dd/MM')|capitalize %}
                                                        {% if timeslotsParJour[jourCle] is not defined %}
                                                            {% set timeslotsParJour = timeslotsParJour|merge({(jourCle): [ts] }) %}
                                                        {% else %}
                                                            {% set timeslotsParJour = timeslotsParJour|merge({(jourCle): timeslotsParJour[jourCle]|merge([ts]) }) %}
                                                        {% endif %}
                                                    {% endfor %}

                                                    {% for jourCle, listeTimeslots in timeslotsParJour|sort((a, b) => a[0].date <=> b[0].date) %}
                                                        <p class="font-semibold text-primary mt-2">{{ jourCle }}</p>
                                                        {% for ts in listeTimeslots|sort((a, b) => a.fromTime <=> b.fromTime) %}
                                                            <div class="mx-3">
                                                                <div class="mt-2">
                                                                    <span
                                                                        class="underline">Horaire</span>: {{ ts.fromTime|date('H:i') }}
                                                                    - {{ ts.toTime|date('H:i') }}
                                                                </div>
                                                                <div>
                                                                    <span
                                                                        class="underline">Salle</span>: {{ ts.workshop.roomNumber }}
                                                                </div>
                                                                <div class="text-gray-600">
                                                                    {% if ts.reservations|length >= workshop.maxSlots %}
                                                                        Complet
                                                                    {% else %}
                                                                        Places: {{ ts.reservations|length }} / {{ workshop.maxSlots }}
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                        {% endfor %}
                                                    {% endfor %}

                                                {% else %}
                                                    <p class="text-center text-gray-500 my-4">Aucun créneau à venir disponible.</p>
                                                {% endif %}

                                                <div class="flex flex-col items-center justify-center mt-4 space-y-2">
                                                    {% if available_timeslots_count > 0 %}
                                                        <a href="{{ path('app_workshop_subscribe', {'id': workshop.id}) }}"
                                                           class="block text-center text-white rounded px-4 py-2 font-medium bg-[#22bb33] hover:shadow-sm transition w-3xs">
                                                            S'inscrire
                                                        </a>
                                                    {% else %}
                                                        <span
                                                            class="block text-center text-white rounded px-4 py-2 font-medium bg-gray-400 cursor-not-allowed w-3xs">
                                                            Complet ou passé
                                                        </span>
                                                    {% endif %}
                                                </div>

                                            </div>
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <p class="col-span-3 text-center text-gray-400">Aucun atelier disponible.</p>
                                {% endfor %}
                            </div>

                        </div>
                        <p class="text-[var(--foreground)] text-center my-6">
                            Si vous n'êtes pas sur et voudriez échanger pour avoir plus d'informations vous pouvez
                            demander
                            un entretien individuel :
                        </p>
                        <div class="flex flex-col items-center justify-center mt-15 mb-6 gap-4">
                            {% if isRendezVousAvailable %}
                                <twig:Link href="{{ path('app_rendez_vous_new') }}" color="primary">
                                    Prendre Rendez-vous
                                </twig:Link>
                            {% else %}
                                <span
                                    class="block text-center text-white rounded px-4 py-2 font-medium bg-gray-400 cursor-not-allowed">
                                    Rendez-vous Indisponibles
                                </span>
                                <p class="text-gray-500 mb-6 text-base leading-relaxed">Il n'y a plus de créneaux
                                    disponibles pour le moment.</p>
                            {% endif %}
                        </div>

                        <hr class="my-8 border-gray-400">
                        <div class="text-center px-4">
                            <p class="text-gray-500 mb-6 text-base leading-relaxed">
                                Nous vous invitons à répondre, de manière anonyme, à une enquête
                                sur vos usages numériques afin de nous aider dans la conception
                                d'ateliers adaptés.
                            </p>

                            <a href="https://forms.gle/F1n5udhsmvJBkFbv5"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="inline-flex items-center justify-center bg-white border border-gray-300 rounded-lg px-6 py-3 font-medium text-gray-800 hover:bg-gray-50 transition-all shadow-sm mb-2">
                                <span>Répondre à l'enquête *</span>
                                <i class="fa-solid fa-arrow-up-right-from-square ml-2"></i>
                            </a>

                            <p class="text-xs text-gray-400 mt-2">
                                *vous serez redirigé vers Google Forms, merci de n'y répondre qu'une seule fois.
                            </p>
                        </div>

                    </div>

                </twig:Card>
            </div>
        </div>
    </div>
{% endblock %}

