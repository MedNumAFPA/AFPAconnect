{% extends 'base.html.twig' %}


{% block title %}Modifier le mots de passe{% endblock %}

{% block body %}
    <twig:ContainerMobile>
        <twig:CardHome>
            <twig:PageTitle>Modifier le mots de passe</twig:PageTitle>

            <div class="mt-2 mb-2 ml-2">
                <a href="{{ app.request.headers.get('referer') ?? path('app_user_index') }}"
                   class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg shadow hover:bg-gray-100 text-gray-700 font-medium transition">
                    ← Retour
                </a>
            </div>


            <p class="text-sm text-gray-500 mb-4 ml-2">
                Les champs marqués d'un <span class="text-red-500">*</span> sont obligatoires.
            </p>

            {{ form_start(form) }}

            {{ form_label(form.oldPassword, 'Ancien mot de passe', {'label_attr': {'class': 'text-gray-700'}}) }}
            {{ form_widget(form.oldPassword, {'attr': {'class': 'w-full  shadow-sm focus:border-blue-500 '}}) }}


            {{ form_label(form.plainpassword, 'Nouveau mot de passe', {'label_attr': {'class': 'text-gray-700'}}) }}
            {{ form_widget(form.plainpassword, {'attr': {'class': 'w-full  shadow-sm focus:border-blue-500 '}}) }}

            <div class="flex items-center space-x-4 ml-3 mt-3">
                <twig:Button color="primary">
                    {{ button_label|default('Modifier') }}
                </twig:Button>
            </div>

            {{ form_end(form) }}

        </twig:CardHome>
    </twig:ContainerMobile>
{% endblock %}
