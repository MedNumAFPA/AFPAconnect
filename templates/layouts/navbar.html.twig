<nav class="bg-white shadow-md p-4">
    <div class="w-full flex items-center  justify-between ">
        <div class="flex items-center  space-x-6">
            <div class="flex space-x-2 items-center">
                <a href="{{ path('app_homepage') }}">
                    <div class="flex space-x-2 items-center">
                        <img class="max-w-[75px]" src="{{ asset('images/logo.svg') }}" alt="">
                        <img class="max-w-[75px]" src="{{ asset('images/logo-txt.svg') }}" alt="">
                    </div>
                </a>
            </div>
            <ul class="hidden md:flex space-x-4 font-medium">
                {% set current_route = app.request.attributes.get('_route') %}
                <li>
                    <a href="{{ path('app_dashboard_admin') }}"
                       class="hover:text-green-600 {{ current_route == 'app_dashboard_admin' ? 'text-primary font-bold' : '' }}">
                        Admin Dashboard
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_workshops_index') }}"
                       class="hover:text-green-600 {{ current_route starts with 'app_workshops_' ? 'text-primary font-bold' : '' }}">
                        Ateliers
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_time_slots_index') }}"
                       class="hover:text-green-600 {{ current_route starts with 'app_time_slots_' ? 'text-primary font-bold' : '' }}">
                        Créneaux
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_reservations_index') }}"
                       class="hover:text-green-600 {{ current_route starts with 'app_reservations_' ? 'text-primary font-bold' : '' }}">
                        Réservations
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_user_index') }}"
                       class="hover:text-green-600 {{ current_route starts with 'app_user_' ? 'text-primary font-bold' : '' }}">
                        Utilisateurs
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_qr_code') }}"
                       class="hover:text-green-600 {{ current_route == 'app_qr_code' ? 'text-primary font-bold' : '' }}">
                        Qr-codes
                    </a>
                </li>
            </ul>
        </div>
        <div class="hidden md:flex space-x-2">
            {% if app.user %}
                <a href="{{ path('app_logout') }}" class="text-red-600"
                   onclick="return confirm('Es-tu sûr de vouloir te déconnecter ?');">Déconnexion</a>
            {% else %}
                <twig:Link href="{{ path('app_register') }}" color="primary">Inscription</twig:Link>
                <twig:Link href="{{ path('app_login') }}" color="info">Connexion</twig:Link>
            {% endif %}
        </div>
        <button id="burgerBtn" class="flex md:hidden text-xl">
            <i class="fa fa-bars fa-lg"></i>
        </button>
    </div>
    <div id="mobileMenu" class="hidden flex-col mt-4 md:hidden space-y-2">
        <a href="{{ path('app_dashboard_admin') }}" class="px-4 py-2 hover:bg-primary hover:text-white">Admin Dashboard</a>
        <a href="{{ path('app_workshops_index') }}" class="px-4 py-2 hover:bg-primary hover:text-white">Ateliers</a>
        <a href="{{ path('app_time_slots_index') }}" class="px-4 py-2 hover:bg-primary hover:text-white">Créneaux</a>
        <a href="{{ path('app_reservations_index') }}" class="px-4 py-2 hover:bg-primary hover:text-white">Réservations</a>
        <a href="{{ path('app_user_index') }}" class="px-4 py-2 hover:bg-primary hover:text-white">Utilisateurs</a>
        <a href="{{ path('app_qr_code') }}" class="px-4 py-2 hover:bg-primary hover:text-white">Qr-codes</a>
        {% if app.user %}
            <a href="{{ path('app_logout') }}" class="px-4 py-2 text-red-600 hover:bg-red-500 hover:text-white"
               onclick="return confirm('Es-tu sûr de vouloir te déconnecter ?');">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_register') }}" class="px-4 py-2 text-blue-600 hover:bg-blue-500 hover:text-white">Inscription</a>
            <a href="{{ path('app_login') }}" class="px-4 py-2 text-green-600 hover:bg-green-500 hover:text-white">Connexion</a>
        {% endif %}
    </div>
</nav>

<script>
    document.addEventListener("turbo:load", () => {
        const burgerBtn = document.getElementById("burgerBtn");
        const mobileMenu = document.getElementById("mobileMenu");

        if (burgerBtn && mobileMenu && !burgerBtn.dataset.bound) {
            burgerBtn.addEventListener("click", () => {
                mobileMenu.classList.toggle("hidden");
                mobileMenu.classList.toggle("flex");
            });

            // Mark as already bound
            burgerBtn.dataset.bound = "true";
        }
    });
</script>
