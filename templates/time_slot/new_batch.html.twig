{% extends 'base.html.twig' %}

{% form_theme form _self %}

{%- block _workshop_time_slot_dailySlots_entry_morningSlot_row -%}
    <div class="mb-4">
        {{ form_label(form, null, {'label_attr': {'class': 'font-semibold mb-2 block'}}) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{%- endblock -%}

{%- block _workshop_time_slot_dailySlots_entry_afternoonSlot_row -%}
    <div class="mb-4">
        {{ form_label(form, null, {'label_attr': {'class': 'font-semibold mb-2 block'}}) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{%- endblock -%}

{% block title %}Nouveaux créneaux{% endblock %}

{% block body %}
    <twig:ContainerMobile>
        <twig:Card>
            <twig:PageTitle>Nouveaux créneaux</twig:PageTitle>

            <div class="mt-8 mb-8 flex justify-center md:mt-4 md:mb-12 md:justify-start">
                <a href="{{ path('app_time_slot_index') }}"
                   class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg shadow hover:bg-gray-100 text-gray-700 font-medium transition">
                    ← Retour
                </a>
            </div>

            <p class="text-sm text-gray-500 mb-4">
                Les champs marqués d'un <span class="text-red-500">*</span> sont obligatoires.
            </p>
            {{ form_start(form) }}

            {{ form_row(form.workshop) }}

            <h3 class="text-lg font-semibold mt-6 mb-2 ml-3 text-center">Jours</h3>

            {% set prototype %}
                {{ form_row(form.dailySlots.vars.prototype.date) }}
                {{ form_row(form.dailySlots.vars.prototype.morningSlot) }}
                {{ form_row(form.dailySlots.vars.prototype.hasAfternoonSlot) }}
                <div class="afternoon-slot-wrapper">
                    {{ form_row(form.dailySlots.vars.prototype.afternoonSlot) }}
                </div>
                <hr class="my-4">
            {% endset %}

            <ul id="daily-slots-list" class="space-y-4" data-prototype="{{ prototype|e('html_attr') }}"
                data-widget-tags="{{ '<li></li>'|e('html_attr') }}" data-index="{{ form.dailySlots|length }}">
                {% for dayForm in form.dailySlots %}
                    <li>
                        {{ form_row(dayForm.date) }}
                        {{ form_row(dayForm.morningSlot) }}
                        {{ form_row(dayForm.hasAfternoonSlot) }}
                        <div class="afternoon-slot-wrapper">
                            {{ form_row(dayForm.afternoonSlot) }}
                        </div>
                        <hr class="my-4">
                    </li>
                {% endfor %}
            </ul>

            <div class="flex justify-center items-center gap-2 space-x-4 mt-4">
                <button type="button" id="add-day-button"
                        class="bg-green-800 text-white p-4 md:mr-0 mr-0 rounded-md shadow-md hover:shadow-sm">
                    Ajouter un autre jour
                </button>
                <button type="button" id="remove-day-button"
                        class="bg-red-600 text-white p-4 rounded-md shadow-md hover:shadow-sm hidden">
                    Supprimer le dernier jour
                </button>
            </div>

            <div class="mt-6 flex justify-center">
                <button type="submit"
                        class="bg-primary text-white p-4 rounded-md shadow-md hover:shadow-sm">
                    Sauvegarder les créneaux
                </button>
            </div>

            {{ form_end(form) }}
        </twig:Card>
    </twig:ContainerMobile>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('turbo:load', function () {
            const list = document.getElementById('daily-slots-list');
            const addDayButton = document.getElementById('add-day-button');
            const removeDayButton = document.getElementById('remove-day-button'); // On récupère le nouveau bouton

            if (!list || !addDayButton || !removeDayButton) {
                return;
            }

            const updateRemoveButtonVisibility = () => {
                const dayCount = list.querySelectorAll('li').length;
                // Si on a plus d'un jour, on montre le bouton, sinon on le cache.
                if (dayCount > 1) {
                    removeDayButton.classList.remove('hidden');
                } else {
                    removeDayButton.classList.add('hidden');
                }
            };

            // La fonction pour la case à cocher (inchangée)
            const initializeDayFormLogic = (dayFormElement) => {
                const checkbox = dayFormElement.querySelector('input[type="checkbox"][id$="_hasAfternoonSlot"]');
                const afternoonWrapper = dayFormElement.querySelector('.afternoon-slot-wrapper');
                if (!checkbox || !afternoonWrapper) return;
                const updateVisibility = () => {
                    afternoonWrapper.style.display = checkbox.checked ? 'block' : 'none';
                };
                checkbox.addEventListener('change', updateVisibility);
                updateVisibility();
            };

            // On applique aux formulaires existants
            list.querySelectorAll('li').forEach(initializeDayFormLogic);
            // On vérifie l'état initial du bouton supprimer
            updateRemoveButtonVisibility();


            // --- GESTION DU BOUTON "AJOUTER" ---
            addDayButton.addEventListener('click', function () {
                // ... votre logique pour ajouter une nouvelle journée ...
                const lastDateInput = list.querySelector('li:last-child input[type="date"]');
                let nextDate = new Date();
                if (lastDateInput && lastDateInput.value) {
                    const lastDate = new Date(lastDateInput.value);
                    nextDate.setTime(lastDate.getTime() + (24 * 60 * 60 * 1000));
                }
                const year = nextDate.getFullYear();
                const month = String(nextDate.getMonth() + 1).padStart(2, '0');
                const day = String(nextDate.getDate()).padStart(2, '0');
                const nextDayString = `${year}-${month}-${day}`;

                let index = parseInt(list.dataset.index);
                let prototype = list.dataset.prototype;
                let newFormHtml = prototype.replace(/__name__/g, index);

                const newLi = document.createElement('li');
                newLi.innerHTML = newFormHtml;
                list.appendChild(newLi);

                const newDateInput = newLi.querySelector('input[type="date"]');
                if (newDateInput) {
                    newDateInput.value = nextDayString;
                }

                list.dataset.index = index + 1;
                initializeDayFormLogic(newLi);

                // On met à jour la visibilité du bouton supprimer
                updateRemoveButtonVisibility();
            });

            // --- NOUVELLE LOGIQUE POUR LE BOUTON "SUPPRIMER" ---
            removeDayButton.addEventListener('click', function () {
                const lastDay = list.querySelector('li:last-child');
                if (lastDay) {
                    list.removeChild(lastDay);
                    // On décrémente l'index pour que le prochain ajout fonctionne
                    list.dataset.index = parseInt(list.dataset.index) - 1;
                }

                // On met à jour la visibilité du bouton supprimer
                updateRemoveButtonVisibility();
            });
        });
    </script>
{% endblock %}
