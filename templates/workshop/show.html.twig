{% extends 'base.html.twig' %}

{% block title %}Atelier :
    {{ workshop.name }}
{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8 max-w-lg">
        <h1 class="text-center text-2xl font-bold mb-6">
            Atelier :{{ workshop.name }}
        </h1>

        <div class="bg-white shadow-md rounded-lg p-6 mb-6">
            <table class="w-full text-sm text-gray-700">
                <tbody>
                <tr class="border-b">
                    <th class="text-left py-2 font-semibold w-1/3">Id</th>
                    <td class="py-2">{{ workshop.id }}</td>
                </tr>
                <tr class="border-b">
                    <th class="text-left py-2 font-semibold">Nom</th>
                    <td class="py-2">{{ workshop.name }}</td>
                </tr>
                <tr class="border-b">
                    <th class="text-left py-2 font-semibold">Description</th>
                    <td class="py-2">{{ workshop.description }}</td>
                </tr>
                <tr class="border-b">
                    <th class="text-left py-2 font-semibold">Places maximum</th>
                    <td class="py-2">{{ workshop.maxSlots }}</td>
                </tr>
                <tr>
                    <th class="text-left py-2 font-semibold">N° de salle</th>
                    <td class="py-2">{{ workshop.roomNumber }}</td>
                </tr>
                </tbody>
            </table>
        </div>

        <div class="flex justify-end space-x-2">
            <a class="m-5" href="{{ path('app_workshop_index') }}">
                ← Retour
            </a>
            <a href="{{ path('app_workshop_edit', {'id': workshop.id}) }}"
               class="px-2 py-1 bg-blue-500 text-white hover:bg-blue-300">
                Modifier
            </a>
        </div>
        {# {{ include('workshop/_delete_form.html.twig') }} #}
    </div>
{% endblock %}
