{% for type,messages in app.flashes(['success','danger','info'])%}
	{% for message in messages %}
		<div id="toast" class="flex items-center bg-white text-black px-4 py-4 rounded-xl shadow-lg space-x-3 max-w-sm text-center border-1">
			<p>{{message}}</p>
			<button id="closeToast" class="text-gray-900 font-bold">&times;</button>
		</div>

		 <script>
																																	 const toast = document.getElementById('toast');
																																	 const closeBtn = document.getElementById('closeToast');
																																	
																																	   setTimeout(() => {
																																		toast.classList.remove('flex');
																																	     toast.classList.add('hidden');
																																	   }, 3000);
																																		 
																																	closeBtn.addEventListener('click', () => {
																																	toast.classList.remove('flex');
																																	toast.classList.add('hidden');
																																	});
																																	</script>

	{% endfor %}
{% endfor %}
