<form method="post" action="{{ path('app_workshop_delete', {'id': workshop.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet atelier ? /n/n Tous les créneaux et les réservations associées a cet atelier seront aussi supprimées');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ workshop.id) }}">
	<twig:TableButton color="danger">
		<i class="fa-solid fa-trash fa-lg m-1"></i>
	</twig:TableButton>
</form>
