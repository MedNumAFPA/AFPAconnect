{% extends 'base.html.twig' %}

{% block title %}Index utilisateurs
{% endblock %}

{% block body %}
    <twig:ContainerMobile>

        <twig:CardHome>
            <twig:PageTitle>Gestion des utilisateurs</twig:PageTitle>

            <twig:Link color="primary" href="{{ path('app_user_new') }}">Ajouter</twig:Link>

            <div class="mt-8 mb-4 flex justify-center md:mt-4 md:mb-0 md:justify-start">
                <a href="{{ path('app_dashboard_admin') }}"
                   class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg shadow hover:bg-gray-100 text-gray-700 font-medium transition">
                    ← Retour
                </a>
            </div>

            <twig:Table class="hidden md:flex">
                <thead class="uppercase border-b-2 border-neutral-600">
                <tr>
                    <th scope="col" class="px-2 py-4">Id</th>
                    <th scope="col" class="px-2 py-4">Email</th>
                    <th scope="col" class="px-2 py-4">Pseudo</th>
                    <th scope="col" class="px-2 py-4">Roles</th>
                    <th scope="col" class="px-2 py-4">Actions</th>
                </tr>
                </thead>
                <tbody class="">
                {% for user in users %}
                    <tr class="border-b dark:border-neutral-600">
                        <td class="px-2 py-4">{{ user.id }}</td>
                        <td class="px-2 py-4">{{ user.email }}</td>
                        <td class="px-2 py-4">{{ user.nickname }}</td>
                        <td class="px-2 py-4">
                            {% for role in user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="px-1 pt-1 bg-red-600 text-white text-s">Admin</span>
                                {% elseif role == 'ROLE_USER' %}
                                    <span
                                        class="mx-1 p-2 bg-green-800 rounded-full text-white text-xs">Utilisateur</span>
                                {% elseif role == 'ROLE_EDITOR' %}
                                    <span class="px-1 pt-1 bg-yellow-600 text-white text-s">Éditeur</span>
                                {% else %}
                                    {{ role|capitalize }}
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td class="px-2 py-4">
                            <div class="flex flex-row justify-center space-x-3 actions">
                                <twig:TableLink color="info" href="{{ path('app_user_edit', {'id': user.id}) }}">
                                    <i class="fa-solid fa-pen-to-square fa-lg m-1"></i>

                                </twig:TableLink>
                                {{ include('user/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-4 text-center text-gray-500">Il n'y a aucun utilisateur à
                            afficher
                            pour le moment.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </twig:Table>



            {# mobile part #}
            <div class="flex flex-col items-center md:hidden text-sm text-center w-full p-3">

                {% for user in users %}
                    <twig:RecordCard title="
                        {{ user.nickname|length > 16 ? user.nickname|slice(0, 15) ~ '...' : user.nickname }}
                    " class="w-full mb-4 break-words">
                        <table class="text-left my-5">
                            <tr>
                                <th scope="row" class="p-1">Id :</th>
                                <td class="p-1">{{ user.id }}</td>
                            </tr>
                            <tr>
                                <th scope="row" class="p-1">email :</th>

                                <td class="p-1 break-words">
                                {{ user.email|length > 15 ? user.email|slice(0, 15) ~ '...' : user.email }}
                                </td>
                            </tr>
                            <tr class="">
                                <th scope="row" class="p-1 pt-2">Role :</th>
                                <td class="">
                                    {% for role in user.roles %}
                                        {% if role == 'ROLE_ADMIN' %}
                                            <span class="px-1 pt-2 bg-red-600 text-white text-s">Admin</span>
                                        {% elseif role == 'ROLE_USER' %}
                                            <span class="mx-1 p-2 bg-green-800 rounded-full text-white text-xs">Utilisateur</span>
                                        {% elseif role == 'ROLE_EDITOR' %}
                                            <span class="px-1 pt-1 bg-yellow-600 text-white text-s">Éditeur</span>
                                        {% else %}
                                            {{ role|capitalize }}
                                        {% endif %}
                                    {% endfor %}
                                </td>
                            </tr>
                        </table>
                        <div class="flex flex-row justify-center space-x-3 actions">
                            <twig:TableLink color="info" href="{{ path('app_user_edit', {'id': user.id}) }}">
                                <i class="fa-solid fa-pen-to-square fa-lg m-1"></i>
                            </twig:TableLink>
                            {{ include('user/_delete_form.html.twig') }}
                        </div>
                    </twig:RecordCard>
                {% endfor %}
            </div>

        </twig:CardHome>
    </twig:ContainerMobile>
{% endblock %}
