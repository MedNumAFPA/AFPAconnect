{% extends 'base.html.twig' %}

{% block title %}Connexion
{% endblock %}

{% block body %}
    <twig:Container>
        <twig:Card>

            <form method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        Vous êtes connecté en tant que
                        {{ app.user.userIdentifier }},
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    </div>
                {% endif %}

                <twig:PageTitle class="h3 mb-3 font-weight-normal">Connectez-vous</twig:PageTitle>

                <p class="text-sm text-gray-500 mb-4">
                    Les champs marqués d'un <span class="text-red-500">*</span> sont obligatoires.
                </p>

                <label for="username" class="required">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control"
                       autocomplete="email" required autofocus placeholder="Entrez une adresse email valide...">
                <label for="password" class="required">Mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control"
                       autocomplete="current-password" required
                       placeholder="Entrez un mot de passe de 6 caractères minimum...">
                <input
                    type="hidden" name="_csrf_token" data-controller="csrf-protection"
                    value="{{ csrf_token('authenticate') }}">

                {#
                Décommentez cette section et ajoutez l'option remember_me sous votre pare-feu pour activer la fonctionnalité "Se souvenir de moi".
                Voir https://symfony.com/doc/current/security/remember_me.html

                <div class="checkbox mb-3">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <label for="_remember_me">Se souvenir de moi</label>
                </div>
                #}
                <div class="flex items-center space-x-4 ml-3 mt-3">
                    <twig:Button color="primary" type="submit">
                        Se connecter
                    </twig:Button>
                </div>
            </form>
        </twig:Card>
    </twig:Container>

{% endblock %}
