{% extends 'base.html.twig' %}

{% block title %}Créer des créneaux pour un atelier{% endblock %}

{% block body %}
    <twig:Container>
        <twig:Card>
            <twig:PageTitle>Créer des créneaux pour un atelier</twig:PageTitle>

            {{ form_start(form) }}

            {{ form_row(form.workshop) }}

            <h3 class="text-lg font-semibold mt-6 mb-2">Jours</h3>

            <ul id="daily-slots-list" class="space-y-4" data-prototype="{{ form_widget(form.dailySlots.vars.prototype)|e('html_attr') }}" data-widget-tags="{{ '<li></li>'|e('html_attr') }}" data-index="{{ form.dailySlots|length }}">

                {% for dayForm in form.dailySlots %}
                    <li>
                        {{ form_row(dayForm.date) }}
                        {{ form_row(dayForm.morningSlot) }}

                        {# La case à cocher pour l'après-midi #}
                        {{ form_row(dayForm.hasAfternoonSlot) }}

                        {# Le conteneur que notre JavaScript va masquer/afficher #}
                        <div class="afternoon-slot-wrapper">
                            {{ form_row(dayForm.afternoonSlot) }}
                        </div>
                        <hr class="my-4">
                    </li>
                {% endfor %}
            </ul>

            <button type="button" id="add-day-button" class="mt-4 px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">
                Ajouter une autre journée
            </button>

            <div class="mt-6">
                <button type="submit" class="px-6 py-2 bg-green-600 text-white font-semibold rounded hover:bg-green-700">Sauvegarder tous les créneaux</button>
            </div>

            {{ form_end(form) }}
        </twig:Card>
    </twig:Container>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const list = document.getElementById('daily-slots-list');
            const addDayButton = document.getElementById('add-day-button');

            // --- PARTIE 1 : FAIRE FONCTIONNER LES FORMULAIRES EXISTANTS ---
            // On trouve tous les formulaires qui sont déjà sur la page au chargement.
            list.querySelectorAll('li').forEach(function (li) {
                const checkbox = li.querySelector('input[type="checkbox"][id$="_hasAfternoonSlot"]');
                const wrapper = li.querySelector('.afternoon-slot-wrapper');

                if (checkbox && wrapper) {
                    // Fonction simple pour afficher ou masquer
                    const toggleVisibility = function () {
                        wrapper.style.display = checkbox.checked ? 'block' : 'none';
                    };

                    // On attache l'événement
                    checkbox.addEventListener('change', toggleVisibility);

                    // On définit l'état de départ
                    toggleVisibility();
                }
            });

            // --- PARTIE 2 : FAIRE FONCTIONNER LE BOUTON "AJOUTER" ---
            addDayButton.addEventListener('click', function () {
                // --- Logique pour la date et la création du nouveau formulaire (cette partie fonctionnait déjà) ---
                const lastDateInput = list.querySelector('li:last-child input[type="date"]');
                let nextDate = new Date();
                if (lastDateInput && lastDateInput.value) {
                    const lastDate = new Date(lastDateInput.value);
                    nextDate.setTime(lastDate.getTime() + (24 * 60 * 60 * 1000));
                }
                const year = nextDate.getFullYear();
                const month = String(nextDate.getMonth() + 1).padStart(2, '0');
                const day = String(nextDate.getDate()).padStart(2, '0');
                const nextDayString = `${year}-${month}-${day}`;

                let index = parseInt(list.dataset.index);
                let prototype = list.dataset.prototype;
                let newFormHtml = prototype.replace(/__name__/g, index);

                const newLi = document.createElement('li');
                newLi.innerHTML = newFormHtml;
                list.appendChild(newLi);

                const newDateInput = newLi.querySelector('input[type="date"]');
                if (newDateInput) {
                    newDateInput.value = nextDayString;
                }

                list.dataset.index = index + 1;

                // --- LOGIQUE POUR LE NOUVEAU FORMULAIRE QU'ON VIENT D'AJOUTER ---
                // On cible la case à cocher et le conteneur UNIQUEMENT dans le nouveau 'li'
                const newCheckbox = newLi.querySelector('input[type="checkbox"][id$="_hasAfternoonSlot"]');
                const newWrapper = newLi.querySelector('.afternoon-slot-wrapper');

                if (newCheckbox && newWrapper) {
                    const toggleNewVisibility = function () {
                        newWrapper.style.display = newCheckbox.checked ? 'block' : 'none';
                    };

                    newCheckbox.addEventListener('change', toggleNewVisibility);

                    // On définit l'état de départ pour ce nouvel élément
                    toggleNewVisibility();
                }
            });
        });
    </script>
{% endblock %}
