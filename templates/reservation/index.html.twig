{% extends 'base.html.twig' %}

{% block title %}
    Réservations
{% endblock %}

{% block body %}
    <twig:Container>
        {% include "layouts/flash_message.html.twig" %}

        <twig:Card>
            <twig:PageTitle>Réservations</twig:PageTitle>

            <twig:Link color="primary" href="{{ path('app_reservation_new') }}">Ajouter</twig:Link>

            <div class="mt-8 mb-4 flex justify-center md:mt-4 md:mb-0 md:justify-start">
                <a href="{{ path('app_dashboard_admin') }}"
                   class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg shadow hover:bg-gray-100 text-gray-700 font-medium transition">
                    ← Retour
                </a>
            </div>

            <twig:Table class="hidden md:flex">
                <thead class="uppercase border-b-2 border-neutral-600">
                <tr>
                    <th scope="col" class="px-2 py-4">Id</th>
                    <th scope="col" class="px-2 py-4">Prénom</th>
                    <th scope="col" class="px-2 py-4">Nom</th>
                    <th scope="col" class="px-2 py-4">Email</th>
                    <th scope="col" class="px-2 py-4">N° téléphone</th>
                    <th scope="col" class="px-2 py-4">N° formation</th>
                    <th scope="col" class="px-2 py-4">Rappel activé ?</th>
                    <th scope="col" class="px-2 py-4">Rappel envoyé ?</th>
                    <th scope="col" class="px-2 py-4">Créneau</th>
                    <th scope="col" class="px-2 py-4">Actions</th>
                </tr>
                </thead>
                <tbody class="border-x border-b border-gray-300 rounded-lg">
                {% for reservation in reservations %}
                    <tr class="border-b dark:border-neutral-600">
                        <td class="px-2 py-4">{{ reservation.id }}</td>
                        <td class="px-2 py-4">{{ reservation.firstname }}</td>
                        <td class="px-2 py-4">{{ reservation.lastname }}</td>
                        <td class="px-2 py-4">{{ reservation.email }}</td>
                        <td class="px-2 py-4">{{ reservation.phoneNumber }}</td>
                        <td class="px-2 py-4">{{ reservation.formationName }}</td>
                        <td class="px-2 py-4">{{ reservation.isReminderActive ? 'Oui' : 'Non' }}</td>
                        <td class="px-2 py-4">{{ reservation.reminderSentAt ? reservation.reminderSentAt|date('d/m/Y à H:i') : 'Non envoyé' }}</td>
                        <td class="px-2 py-4">
                            <div>{{ reservation.timeslot.fromTime|format_time(locale='fr', pattern='HH:mm') }}</div>
                            <div>-</div>
                            <div>{{ reservation.timeslot.toTime|format_time(locale='fr', pattern='HH:mm') }}</div>
                        </td>

                        <td class="px-2 py-4">
                            <div class="flex flex-row justify-center space-x-3 actions">
                                <twig:TableLink color="info"
                                                href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">
                                    <i class="fa-solid fa-pen-to-square fa-lg m-1"></i>
                                </twig:TableLink>
                                {{ include('reservation/_delete_form.html.twig', { 'reservation': reservation }) }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="px-6 py-4 text-center text-gray-500">Aucune réservation pour le moment.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </twig:Table>





{# mobile part#}
            <div class="flex flex-col items-center md:hidden text-sm text-center w-full p-3">

                {% for reservation in reservations %}
                    <twig:RecordCard title="{{ reservation.firstname }} {{ reservation.lastname }}">

                        <table class="text-left my-5">
                            <tr>
                                <th scope="row" class="py-1">Prénom :</th>
                                <td class="py-1">{{ reservation.firstname }}</td>
                            </tr>

                            <tr>
                                <th scope="row" class="py-1">Nom :</th>
                                <td class="">{{ reservation.lastname }}</td>
                            </tr>

                            <tr>
                                <th scope="row" class="py-1">Email :</th>
                                <td class=" text-wrap">
                                    {{ reservation.email |length > 12 ? reservation.email | slice(0, 12) ~ '...'  : reservation.email }}
                                </td>
                            </tr>

                            <tr>
                                <th scope="row" class="py-1">N.Téléphone :</th>
                                <td class="">{{ reservation.phoneNumber }}</td>
                            </tr>

                            <tr>
                                <th scope="row" class="py-1">N.Formation :</th>
                                <td class="">
                                    {{ reservation.formationName |length > 14 ? reservation.formationName | slice(0, 14) ~ ' ...' : reservation.formationName }}
                                </td>
                            </tr>
                            <tr>
                                <th scope="row" class="py-1">Rpl activé ?:</th>
                                <td class="">
                                    {{ reservation.isReminderActive ? 'Oui' : 'Non' }}
                                </td>
                            </tr>

                            <tr>
                                <th scope="row" class="py-1">Rpl envoyé a :</th>
                                <td class="">
                                    {{ reservation.reminderSentAt ? reservation.reminderSentAt|date('d/m/Y à H:i') : 'Non envoyé' }}
                                </td>
                            </tr>

                            <tr>
                                <th scope="row" class="py-1">Créneau :</th>
                                <td class="">
                                    {{ reservation.timeslot.fromTime|format_time(locale='fr', pattern='HH:mm') }}
                                    -
                                    {{ reservation.timeslot.toTime|format_time(locale='fr', pattern='HH:mm') }}
                                </td>
                            </tr>

                        </table>
                        <div class="flex flex-row justify-center space-x-3 actions">
                            <twig:TableLink color="info"
                                            href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">
                                <i class="fa-solid fa-pen-to-square fa-lg m-1"></i>
                            </twig:TableLink>
                            {{ include('reservation/_delete_form.html.twig', { 'reservation': reservation }) }}
                        </div>
                    </twig:RecordCard>
                {% endfor %}
            </div>



        </twig:Card>
    </twig:Container>
{% endblock %}
