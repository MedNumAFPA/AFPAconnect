 {% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}

<h2 class="text-center">Dashboard Admin</h2>



<div class="flex flex-row gap-4 justify-center items-center">
    <a href="{{ path('app_user_index') }}" class="w-[300px] h-[100px] bg-blue-500 text-white flex items-center justify-center text-center hover:bg-blue-700 transition">Gérer les utilisateurs</a>
    <a href="{{ path('app_reservations_index') }}" class="w-[300px] h-[100px] bg-blue-500 text-white flex items-center justify-center text-center hover:bg-blue-700 transition">Gérer les Crenaux</a>
    <a href="{{ path('app_workshops_index') }}" class="w-[300px] h-[100px] bg-blue-500 text-white flex items-center justify-center  text-center hover:bg-blue-700 transition">Gérer les Atelier</a>
</div>
<ul class="mt-4 flex space-x-2 border-b">
  <li>
    <button onclick="showTab('tab1')" class="px-2 py-1 bg-gray-100 hover:text-blue-400 rounded-t-lg font-medium" id="btn1">Semaine 38</button>
  </li>
  <li>
    <button onclick="showTab('tab2')" class="px-2 py-1 bg-gray-50 hover:text-blue-400 rounded-t-lg font-medium" id="btn2">Semaine 39</button>
  </li>
    <li>
    <button onclick="showTab('tab3')" class="px-2 py-1 bg-gray-50 hover:text-blue-400 rounded-t-lg font-medium" id="btn3">Semaine 40</button>
  </li>
      <li>
    <button onclick="showTab('tab4')" class="px-2 py-1 bg-gray-50 hover:text-blue-400 rounded-t-lg font-medium" id="btn4">Semaine 41</button>
  </li>
</ul>

{# Boucle sur les 4 semaines dynamiquement #}
{% for i in 1..4 %}
  <div id="tab{{ i }}" class="mt-4 {% if i != 1 %}hidden{% endif %}">
    <table class="min-w-full text-sm">

      <thead>
        <tr class="bg-gray-200 font-bold">
        {% set semaineKey = 'semaine' ~ i %}
          {% for day in days %}
          <td class="p-2">
            {{ day|capitalize }}<br>
            {{ weekDates[semaineKey][day]|date('d/m/Y') }}
          </td>
          {% endfor %}
        </tr>
      </thead>
      
      <tbody>
        <tr>
          {% set semaineKey = 'semaine' ~ i %}
          {% for day in days %}
            <td class="p-2 align-top">
              {% set timeslotday = week[semaineKey][day] ?? [] %}
              {% if timeslotday is not empty %}
                {% for timeslot in timeslotday %}
                  <div>
                    <strong>{{ timeslot.workshop.name }}</strong><br>
                    {{ timeslot.fromTime|date('H:i') }} - {{ timeslot.toTime|date('H:i') }}<br>
                    Salle : {{ timeslot.workshop.roomNumber }}<br>
                    Places max : {{ timeslot.workshop.maxSlots }}<br><hr>
                  </div>
                {% endfor %}
              {% else %}
                <div>Aucun atelier</div>
              {% endif %}
            </td>
          {% endfor %}
        </tr>
      </tbody>

    </table>
  </div>
{% endfor %}
 {{ encore_entry_script_tags('app') }}
{% endblock %}