<form method="post" action="{{ path('app_workshops_delete', {'id': workshop.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet atelier ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ workshop.id) }}">
	<twig:Button color="danger">
		<i class="fa-solid fa-trash fa-lg m-1"></i>

	</twig:Button>
</form>
